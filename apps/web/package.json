{
  "name": "@bulletinmail/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/worker/index.ts",
  "scripts": {
    "dev:docs": "astro dev",
    "dev:worker": "wrangler dev",
    "build": "astro build && node build-admin.mjs",
    "build:docs": "astro build",
    "build:admin": "node build-admin.mjs",
    "preview": "astro preview",
    "deploy": "wrangler deploy --config wrangler.generated.toml",
    "typecheck": "astro check && tsc --noEmit -p src/worker/tsconfig.json && tsc --noEmit -p src/admin/tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.30.0",
    "@bulletinmail/db": "workspace:*",
    "@bulletinmail/shared": "workspace:*",
    "astro": "^5.0.0",
    "hono": "^4.6.0",
    "marked": "^15.0.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
