---
/*
 * Custom <head> override — replaces Starlight's default Head.astro.
 *
 * Diff from upstream:
 *   - <title> uses `${siteTitle} // ${pageTitle}` format with the site name
 *     first. When pageTitle === siteTitle (the splash), renders just the site
 *     title — avoids "BulletinMail // BulletinMail".
 *   - og:title mirrors the page <title>.
 *   - Inlines a tiny createHead (merge-by-tag) and fileWithBase (base prefix)
 *     because Starlight's `utils/*` deep imports aren't exported from the
 *     installed package. Multilingual handling and the Starlight-version
 *     meta tag are dropped (single-language, the meta is informational).
 *
 * If Starlight ever surfaces its head utilities or grows a per-page title
 * hook, replace this with the upstream approach. Re-check on Starlight upgrade.
 */
import context from "virtual:starlight/project-context";
import config from "virtual:starlight/user-config";

const { entry, lang, siteTitle } = Astro.props as {
  entry: { data: { title: string; description?: string; head?: HeadTag[] } };
  lang: string;
  siteTitle: string;
};
const { data } = entry;

type HeadTag = {
  tag: "title" | "meta" | "link" | "script" | "style" | "noscript";
  attrs?: Record<string, string | boolean | undefined>;
  content?: string;
};

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const description = data.description || config.description;

// "BulletinMail // Self-hosting guide" — or just "BulletinMail" on the home
// where the page title equals the site title.
const composedTitle =
  data.title === siteTitle ? siteTitle : `${siteTitle} // ${data.title}`;

const base = (config as { base?: string }).base ?? "/";
const fileWithBase = (path: string): string => {
  if (path.startsWith("http")) return path;
  const trimmed = path.startsWith("/") ? path.slice(1) : path;
  return base.endsWith("/") ? `${base}${trimmed}` : `${base}/${trimmed}`;
};

const headDefaults: HeadTag[] = [
  { tag: "meta", attrs: { charset: "utf-8" } },
  {
    tag: "meta",
    attrs: { name: "viewport", content: "width=device-width, initial-scale=1" },
  },
  { tag: "title", content: composedTitle },
  { tag: "link", attrs: { rel: "canonical", href: canonical?.href } },
  { tag: "meta", attrs: { name: "generator", content: Astro.generator } },
  {
    tag: "link",
    attrs: {
      rel: "shortcut icon",
      href: fileWithBase(config.favicon.href),
      type: config.favicon.type,
    },
  },
  { tag: "meta", attrs: { property: "og:title", content: composedTitle } },
  { tag: "meta", attrs: { property: "og:type", content: "article" } },
  { tag: "meta", attrs: { property: "og:url", content: canonical?.href } },
  { tag: "meta", attrs: { property: "og:locale", content: lang } },
  { tag: "meta", attrs: { property: "og:description", content: description } },
  { tag: "meta", attrs: { property: "og:site_name", content: siteTitle } },
  {
    tag: "meta",
    attrs: { name: "twitter:card", content: "summary_large_image" },
  },
];

if (description)
  headDefaults.push({
    tag: "meta",
    attrs: { name: "description", content: description },
  });

if (Astro.site) {
  headDefaults.push({
    tag: "link",
    attrs: { rel: "sitemap", href: fileWithBase("/sitemap-index.xml") },
  });
}

if (config.social?.twitter) {
  headDefaults.push({
    tag: "meta",
    attrs: {
      name: "twitter:site",
      content: new URL(config.social.twitter.url).pathname,
    },
  });
}

// Mini createHead: later sources override earlier ones, matched by tag kind +
// identifying attribute. Mirrors @astrojs/starlight/utils/head.ts behavior
// closely enough for our needs (title/meta name/property/canonical link).
function identityKey(t: HeadTag): string | null {
  if (t.tag === "title") return "title";
  if (t.tag === "meta") {
    const a = t.attrs ?? {};
    if (typeof a.name === "string") return `meta:name:${a.name}`;
    if (typeof a.property === "string") return `meta:property:${a.property}`;
    if (typeof a["http-equiv"] === "string")
      return `meta:http-equiv:${a["http-equiv"]}`;
    if (a.charset) return "meta:charset";
    return null;
  }
  if (t.tag === "link" && t.attrs?.rel === "canonical") return "link:canonical";
  return null;
}

function mergeHead(...sources: (HeadTag[] | undefined)[]): HeadTag[] {
  const merged = new Map<string, HeadTag>();
  const extras: HeadTag[] = [];
  for (const source of sources) {
    if (!source) continue;
    for (const t of source) {
      const key = identityKey(t);
      if (key) merged.set(key, t);
      else extras.push(t);
    }
  }
  return [...merged.values(), ...extras];
}

const userConfigHead = (config as { head?: HeadTag[] }).head ?? [];
const head = mergeHead(headDefaults, userConfigHead, data.head);
void context;
---

{
  head.map(({ tag: Tag, attrs, content }) => (
    <Tag {...attrs} set:html={content} />
  ))
}
